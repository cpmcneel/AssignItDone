# Copy this file to .env in the backend folder; it is loaded automatically.
# Use plain KEY=value entries without quotes or export statements.
# Enable the ai profile only after providing a real key and cloud model ID.
SPRING_PROFILES_ACTIVE=ai
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=your-cloud-model
OLLAMA_API_KEY=
